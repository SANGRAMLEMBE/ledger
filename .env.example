# Razorpay TEST-MODE credentials.
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored;
# this example file is committed so contributors know what is required.
#
# Where these come from:
#   dashboard.razorpay.com -> switch to TEST MODE -> Settings -> API Keys
#   -> Generate Test Key. The secret is displayed exactly once.
#
# A test key id always starts with `rzp_test_`. If yours starts with
# `rzp_live_` you are pointed at production data — stop and switch modes.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# API credentials, as `token:subject:role` entries separated by commas.
# Roles: viewer | reviewer | controller | admin
#
# There is deliberately no default. A static development credential is the one
# that reaches production and the one nobody rotates. Generate real ones with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
#
# For local work you can instead set LEDGER_DEV_MODE=1, which generates a
# single-session controller token and prints it at startup.
LEDGER_API_TOKENS=
